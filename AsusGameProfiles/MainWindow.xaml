<Window x:Class="AsusGameProfiles.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AsusGameProfiles -- Screen Profiles per Game"
        Height="800" Width="1080"
        MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Icon="/Assets/AppIcon.ico"
        Background="{DynamicResource BackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                             CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar: replaces the native Windows caption so it can follow the app's own
             theme/brushes instead of raw OS chrome. WindowChrome (Window-level, above) treats any
             hit-testable area in this row NOT marked IsHitTestVisibleInChrome="True" as the drag
             region, which is what makes the row draggable and double-click-to-maximize work without
             extra code; the three buttons opt back into normal click handling explicitly. -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Image Source="/Assets/AppIcon.png" Width="18" Height="18" Margin="0,0,9,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="AsusGameProfiles -- Screen Profiles per Game" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonBase}" Click="OnMinimizeClick"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize"
                            AutomationProperties.Name="Minimize">
                        <Path Data="M0,5 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonBase}" Click="OnMaximizeRestoreClick"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximize"
                            AutomationProperties.Name="Maximize">
                        <Path x:Name="MaximizeGlyph" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CaptionButtonClose}" Click="OnCloseButtonClick"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close"
                            AutomationProperties.Name="Close">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

    <Grid Grid.Row="1" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Banner: app identity, spans both columns -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1" CornerRadius="14" Padding="20,16">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/AppIcon.png" Width="44" Height="44" Margin="0,0,16,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="AsusGameProfiles" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="The right screen profile for every game, applied the instant you play."
                               FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Left column: presets, then games -->
        <Border Grid.Row="2" Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource OutlineBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="150"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource SectionHeader}" FontSize="14" Text="Presets" Margin="0,0,0,8"/>
                <ListBox x:Name="PresetsListBox" Grid.Row="1" SelectionChanged="OnPresetSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,5">
                                <TextBlock Text="{Binding Name}" FontSize="13"/>
                                <TextBlock Text="{Binding ExitLabel}" FontSize="11" Margin="0,1,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="AddPresetButton" Content="+" Click="OnAddPresetClick"
                            Style="{StaticResource IconButtonGreen}" ToolTip="New preset"
                            AutomationProperties.Name="New preset"/>
                    <Button x:Name="RemovePresetButton" Content="−" Click="OnRemovePresetClick"
                            Style="{StaticResource IconButtonRed}" ToolTip="Delete preset"
                            Margin="8,0,0,0" IsEnabled="False"
                            AutomationProperties.Name="Delete preset"/>
                </StackPanel>

                <Border Grid.Row="4" Background="{DynamicResource OutlineBrush}" Height="1"/>

                <TextBlock Grid.Row="6" Style="{StaticResource SectionHeader}" FontSize="14" Text="Your games" Margin="0,0,0,8"/>
                <ListBox x:Name="ProfilesListBox" Grid.Row="7" SelectionChanged="OnProfileSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <Border x:Name="IconSlot" Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Grid>
                                        <Image Width="30" Height="30" Source="{Binding Profile.ExePath, Converter={StaticResource ExePathToIconConverter}}">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="0,0,30,30" RadiusX="8" RadiusY="8"/>
                                            </Image.Clip>
                                        </Image>
                                        <!-- Pas d'executable (ligne "Default exit profile" epinglee) : glyphe generique a la place. -->
                                        <TextBlock x:Name="DefaultGlyph" Text="&#9881;" FontSize="15" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Profile.DisplayName}" FontSize="13"/>
                                    <!-- Preset assigne ou "No preset", absent pour la ligne "Default exit profile"
                                         epinglee (SubtitleText reste null pour elle). -->
                                    <TextBlock x:Name="SubtitleTextBlock" Text="{Binding SubtitleText}" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Profile.ExePath}" Value="">
                                    <Setter TargetName="DefaultGlyph" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="IconSlot" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SubtitleText}" Value="{x:Null}">
                                    <Setter TargetName="SubtitleTextBlock" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="8" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="AddButton" Content="+" Click="OnAddClick"
                            Style="{StaticResource IconButtonGreen}" ToolTip="Add a game"
                            AutomationProperties.Name="Add a game"/>
                    <Button x:Name="RemoveButton" Content="−" Click="OnRemoveClick"
                            Style="{StaticResource IconButtonRed}" ToolTip="Remove selected game"
                            Margin="8,0,0,0" IsEnabled="False"
                            AutomationProperties.Name="Remove selected game"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Right column: system status, selected preset/game/default editor -->
        <DockPanel Grid.Row="2" Grid.Column="2">

            <!-- Top: app-wide settings (start at boot, close to tray) -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                <CheckBox x:Name="StartAtBootCheck" Content="Start with Windows"
                          Checked="OnAppSettingChanged" Unchecked="OnAppSettingChanged" Margin="0,0,18,0"
                          ToolTip="Recommended: profiles are only applied while this app is running. Starting it with Windows means it's already watching by the time you launch a game."/>
                <CheckBox x:Name="CloseToTrayCheck" Content="Close to tray"
                          Checked="OnAppSettingChanged" Unchecked="OnAppSettingChanged"
                          ToolTip="Recommended: closing the window normally (the X button) quits the app and stops watching for games. This keeps it running in the background, minimized to the system tray, instead."/>
            </StackPanel>

            <!-- Bottom: display info + dwc.exe/Steam status, side by side -->
            <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="DisplayCard" Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="52" Height="52" Margin="0,0,14,0" CornerRadius="12"
                                Background="{DynamicResource SurfaceHoverBrush}" VerticalAlignment="Center">
                            <Path Stretch="Uniform" Margin="13" Data="M3,5 L21,5 21,17 3,17 Z M9,21 L15,21 M12,17 L12,21"
                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="DisplayModelText" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DisplayTechInfoText" Style="{StaticResource Hint}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="ASUS Display Control CLI (dwc.exe)" FontSize="12"/>
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border x:Name="DwcStatusIcon" Width="22" Height="22" CornerRadius="11" Margin="0,0,10,0">
                                    <Path x:Name="DwcStatusGlyph" Stretch="Uniform" Margin="6" Stroke="White" StrokeThickness="2.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Border>
                                <TextBlock x:Name="DwcStatusText" VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap" MaxWidth="180"/>
                            </StackPanel>
                            <Button x:Name="DwcBrowseButton" Content="…" Click="OnBrowseDwcClick"
                                    Padding="12,6" Margin="10,0,0,4" ToolTip="Locate dwc.exe manually"
                                    AutomationProperties.Name="Locate dwc.exe manually"/>
                            <Button x:Name="DwcInstallButton" Content="Install dwc.exe" Click="OnInstallDwcClick"
                                    Padding="10,6" FontSize="12" Margin="8,0,0,4" Style="{StaticResource PrimaryButton}"
                                    Visibility="Collapsed"
                                    ToolTip="Downloads dwc.exe from ASUS's official open-source repository (github.com/ASUS-Display/asus-display-control)"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Fills the remaining space: EditorPanel / PresetEditorPanel / DefaultEditorPanel / EmptyStateText
                 overlap in the same cell, only their Visibility decides which one shows. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>

            <Grid x:Name="EditorPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <Image x:Name="ProfileTitleIcon" Width="46" Height="46" Margin="0,0,14,0">
                        <Image.Clip>
                            <RectangleGeometry Rect="0,0,46,46" RadiusX="13" RadiusY="13"/>
                        </Image.Clip>
                    </Image>
                    <TextBlock x:Name="ProfileTitleText" Style="{StaticResource SectionHeader}" FontSize="20"
                               VerticalAlignment="Center" Margin="0"/>
                </StackPanel>

                <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Display presets" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="On launch" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Column="1" x:Name="LaunchPresetCombo" DisplayMemberPath="Name"
                                      HorizontalAlignment="Stretch" Margin="0,0,10,0" SelectionChanged="OnGamePresetChanged"/>
                            <Button Grid.Column="2" x:Name="EditLaunchPresetButton" Content="Edit"
                                    Click="OnEditLaunchPresetFromGameClick" Padding="12,6"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="On exit" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox Grid.Column="1" x:Name="ExitPresetCombo" DisplayMemberPath="Name"
                                      HorizontalAlignment="Stretch" Margin="0,0,10,0" SelectionChanged="OnGamePresetChanged"/>
                            <Button Grid.Column="2" x:Name="EditExitPresetButton" Content="Edit"
                                    Click="OnEditExitPresetFromGameClick" Padding="12,6"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button x:Name="SaveButton" Content="Save profile" Click="OnSaveProfileClick"
                            Style="{StaticResource PrimaryButton}" Padding="20,10"/>
                    <Button x:Name="LaunchNowButton" Content="Launch now" Click="OnLaunchNowClick"
                            Padding="20,10" Visibility="Collapsed"/>
                </StackPanel>

                <TextBlock Grid.Row="3" x:Name="WatchStatusText" Style="{StaticResource Hint}"
                           FontSize="12" TextWrapping="Wrap"/>
            </Grid>

            <Grid x:Name="PresetEditorPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Style="{StaticResource Eyebrow}" Text="PRESET NAME"/>
                    <TextBox x:Name="PresetNameBox" FontSize="19" FontWeight="Bold" Padding="10,8" Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="GameVisual mode" Margin="0,0,0,4"
                                   ToolTip="Your monitor's built-in picture preset (color, contrast, sharpness tuned per scenario) -- the same setting you'd normally change from its on-screen menu."/>
                        <ComboBox x:Name="PresetModeCombo" DisplayMemberPath="Label" Margin="0,0,0,12" HorizontalAlignment="Stretch"/>
                        <CheckBox x:Name="PresetBoostCheck" Content="Enable Frame Rate Boost (Dual Mode)" Margin="0,0,0,10"
                                  ToolTip="ASUS's overdrive/refresh-rate boost mode -- can reduce motion blur in fast-moving scenes, at the cost of some input lag depending on the monitor."/>
                        <TextBlock Text="Advanced properties" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,4"/>
                        <StackPanel x:Name="PresetPropertiesPanel"/>
                        <Button Content="+ Add property" Click="OnAddPresetPropertyClick"
                                HorizontalAlignment="Left" Padding="10,4" FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <Button x:Name="SavePresetButton" Content="Save preset" Click="OnSavePresetClick"
                            Style="{StaticResource PrimaryButton}" Padding="20,10"/>
                    <TextBlock x:Name="PresetUsageText" Style="{StaticResource Hint}" FontSize="12"
                               VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="DefaultEditorPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Width="48" Height="48" CornerRadius="10" Background="{DynamicResource SurfaceHoverBrush}" Margin="0,0,14,0">
                        <TextBlock Text="&#9881;" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SectionHeader}" FontSize="20" Text="Default exit profile"/>
                        <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,2,0,0"
                                   Text="Restored when any game closes, unless that game's preset overrides it."/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource OutlineBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Eyebrow}" Text="ON EXIT"/>
                        <TextBlock Text="GameVisual mode" Margin="0,0,0,4"
                                   ToolTip="Your monitor's built-in picture preset (color, contrast, sharpness tuned per scenario) -- the same setting you'd normally change from its on-screen menu."/>
                        <ComboBox x:Name="DefaultExitModeCombo" DisplayMemberPath="Label" Margin="0,0,0,12" HorizontalAlignment="Stretch"/>
                        <CheckBox x:Name="DefaultExitBoostCheck" Content="Enable Frame Rate Boost (Dual Mode)" Margin="0,0,0,10"
                                  ToolTip="ASUS's overdrive/refresh-rate boost mode -- can reduce motion blur in fast-moving scenes, at the cost of some input lag depending on the monitor."/>
                        <TextBlock Text="Advanced properties" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,4"/>
                        <StackPanel x:Name="DefaultExitPropertiesPanel"/>
                        <Button Content="+ Add property" Click="OnAddDefaultExitPropertyClick"
                                HorizontalAlignment="Left" Padding="10,4" FontSize="11" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <Button Content="Save default profile" Click="OnSaveDefaultExitClick"
                            Style="{StaticResource PrimaryButton}" Padding="20,10"/>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="EmptyStateText"
                       Text="Select a game on the left, or add one to get started."
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" Margin="0,40,0,0"
                       HorizontalAlignment="Center" VerticalAlignment="Top"/>
            </Grid>
            </ScrollViewer>
        </DockPanel>
    </Grid>
    </Grid>
</Window>
