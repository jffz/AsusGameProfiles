<Window x:Class="AsusGameProfiles.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm"
        SizeToContent="Height" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Assets/AppIcon.ico"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText" Grid.Row="0" FontSize="14" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" Click="OnCancelClick"
                    Padding="16,6" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="ConfirmButton" Content="Yes" Click="OnConfirmClick" IsDefault="True"
                    Padding="16,6" Background="{DynamicResource DangerBrush}"
                    BorderBrush="{DynamicResource DangerBrush}" Foreground="White" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
