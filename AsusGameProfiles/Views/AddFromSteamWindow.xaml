<Window x:Class="AsusGameProfiles.Views.AddFromSteamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add a game"
        Height="520" Width="480"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/AppIcon.ico"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource Hint}" Margin="0,0,0,10"
                   Text="Games detected in your Steam libraries (read from libraryfolders.vdf and appmanifest_*.acf). Check the ones to add."/>

        <Grid Grid.Row="1">
            <ListBox x:Name="GamesListBox">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnGameRowClick"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- IsHitTestVisible=False : le clic est gere au niveau de toute la ligne (ListBoxItem,
                             voir OnGameRowClick) plutot que sur les seuls pixels rendus de la CheckBox, pour
                             qu'un clic peu precis n'importe ou sur la ligne selectionne quand meme le jeu. -->
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsHitTestVisible="False" Margin="4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Game.Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Game.AppId, StringFormat=' (AppID {0})'}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyStateText" Style="{StaticResource Hint}" FontSize="13"
                       Text="No new Steam games detected. You can still add a game manually below."
                       TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="20" Visibility="Collapsed"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="+ Add manually" Click="OnAddManuallyClick" Padding="16,6" Margin="0,0,8,0"/>
            <Button Content="Cancel" Click="OnCancelClick" Padding="16,6"/>
            <Button Content="Add selection" Click="OnAddClick" Padding="16,6" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
